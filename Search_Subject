rule "Prima Search - subject 653 (subject)"
	when
		MARC."653" has any "a-z" AND NOT
        MARC."653".ind"2" equals "2"
	then
	        set TEMP"1" to MARC."653" subfields "a" delimited by ";" remove substring using regex "\\.+$"
		set TEMP"2" to multilingual by "653" "Subject" "search"
		concatenate with delimiter (TEMP"1",TEMP"2",";")
		replace string by string (TEMP"1","\\s*;\\s*",";")
		remove leading and trailing spaces (TEMP"1")
		return list using regex (TEMP"3",TEMP"1","[^;]+")
		create operational."prima_search"."subject" with list TEMP"3"
end

