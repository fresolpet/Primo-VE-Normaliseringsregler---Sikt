rule "Prima Search - subject 600 (subject)"
	when
		MARC."600" has any "a-z" AND NOT
        MARC."600".ind"2" equals "2"
	then
		set TEMP"1" to MARC."600" sub without sort "a-z"
		set TEMP"2" to multilingual by "600" "Subject" "search"
		concatenate with delimiter (TEMP"1",TEMP"2","")
		create operational."prima_search"."subject" with TEMP"1"
end

